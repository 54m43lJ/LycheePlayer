@startuml seq-play
skinparam shadowing false
skinparam defaultTextAlignment center

actor 用户 as U
participant "Lychee Player" as APP
participant "QQ 音乐" as QQ
participant "桌面环境" as DESKTOP

U -> APP : 双击歌曲 / 播放全部
APP -> QQ : 请求播放链接
alt 有可播链接
  QQ --> APP : 音频流地址
  APP --> U : 开始播放
  APP --> DESKTOP : 发布播放状态
else 无可播链接
  QQ --> APP : 无链接
  APP --> U : 提示不可播
end
@enduml
