@startuml general-architecture
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam shadowing false

actor "用户" as U
component "Lychee Player" as APP

cloud "QQ 音乐" {
  [内容与播放链接 CGI\n(y.qq.com / u.y.qq.com)] as API
  [音频流\n(ws.stream.qqmusic.qq.com)] as STREAM
  [登录组件与授权\n(xlogin / graph.qq.com)] as LOGIN
}

component "系统密钥环\n(libsecret)" as KEYRING
component "桌面环境\n(MPRIS / 托盘)" as DESKTOP

U --> APP : 搜索 · 播放 · 登录
APP --> API : 内容与链接请求
APP --> LOGIN : 扫码登录
APP --> STREAM : 音频流
APP <--> KEYRING : 加密凭证
APP <--> DESKTOP : MPRIS · 托盘
@enduml
