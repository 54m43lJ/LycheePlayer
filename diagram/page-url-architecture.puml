@startuml page-url-architecture
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam shadowing false

[根路径 /] as ROOT
[搜索\n/search] as SEARCH
[发现\n/discover] as DISCOVER
[我的歌单\n/library] as LIBRARY
[歌单详情\n/playlist/:id] as PLAYLIST
[MV 播放\n/mv/:id] as MV
[歌手\n/artist/:mid] as ARTIST
[专辑\n/album/:mid] as ALBUM
[登录\n/login] as LOGIN
[设置\n/settings] as SETTINGS
[下载中心\n/downloads] as DOWNLOADS

ROOT --> SEARCH : 重定向
SEARCH --> PLAYLIST : 点击歌单
SEARCH --> MV : 点击 MV
SEARCH --> ARTIST : 点击歌手
SEARCH --> ALBUM : 点击专辑
DISCOVER --> PLAYLIST : 打开歌单
DISCOVER --> MV : 播放 MV
LIBRARY --> PLAYLIST : 打开歌单
PLAYLIST --> ARTIST : 点击歌手
PLAYLIST --> ALBUM : 点击专辑
PLAYLIST --> LIBRARY : 返回我的歌单
LOGIN --> LIBRARY : 登录成功
ARTIST --> ALBUM : 打开专辑
ALBUM --> ARTIST : 打开歌手

note bottom of DOWNLOADS
  侧栏“下载”为全局入口
end note
@enduml
