@startuml seq-login
skinparam shadowing false
skinparam defaultTextAlignment center

actor 用户 as U
participant "Lychee Player" as APP
participant "QQ 登录" as QQ

U -> APP : 打开登录页
alt 扫码登录（默认）
  APP -> QQ : 启动官方 xlogin 登录\n（见 PROVIDER §3.1）
  QQ --> APP : 登录成功
else Cookie 登录（兜底）
  U -> APP : 粘贴浏览器 Cookie\n（见 PROVIDER §3.2）
end
APP --> U : 进入已登录状态
@enduml
