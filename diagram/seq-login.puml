@startuml seq-login
skinparam shadowing false
skinparam defaultTextAlignment center

actor 用户 as U
participant "Lychee Player" as APP
participant "QQ 登录" as QQ

U -> APP : 打开登录页
APP -> QQ : 显示官方扫码组件
U -> QQ : 扫码并确认
QQ --> APP : 登录成功
APP --> U : 进入已登录状态

break 超时 / 失败
  APP --> U : 提示重新登录
end
@enduml
